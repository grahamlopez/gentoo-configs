#!/usr/bin/env bash
set -Eeuo pipefail

readonly GIT_DIR=/var/lib/gentoo-config/repository.git
readonly WORK_TREE=/
readonly SSH_REMOTE=git@github.com:grahamlopez/gentoo-configs.git

git_config() {
  git --git-dir="$GIT_DIR" --work-tree="$WORK_TREE" "$@"
}

case ${1:-} in
  enable-write)
    git_config remote set-url origin "$SSH_REMOTE"
    printf 'origin now uses SSH for fetch and push: %s\n' "$SSH_REMOTE"
    ;;
  status|diff|add|commit|push|pull|fetch|log|show)
    command=$1
    shift
    git_config "$command" "$@"
    ;;
  git)
    shift
    git_config "$@"
    ;;
  '')
    printf 'usage: gentoo-config {status|diff|add|commit|push|pull|fetch|log|show|git|enable-write} [arguments...]\n' >&2
    exit 2
    ;;
  *)
    printf 'error: unknown gentoo-config command: %s\n' "$1" >&2
    exit 2
    ;;
esac
